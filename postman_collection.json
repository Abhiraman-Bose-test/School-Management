        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Modern School\",\n  \"address\": \"Barakhamba Road, New Delhi\",\n  \"latitude\": 28.6287,\n  \"longitude\": 77.2295\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/addSchool",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "addSchool"
          ]
        },
        "description": "Adds Modern School to the schools table after validating the request body."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"School added successfully\", function () {",
              "    const jsonData = pm.response.json();",
